# vim: syntax=bash
#
# Dev workflow for this fork, run with the vendored `makesure` (0.9.18):
#
#   ./makesure -l          list goals
#   ./makesure up          start backend + frontend
#   ./makesure ts          the same, published on the tailnet
#   ./makesure down        stop everything
#
# Every goal is a thin wrapper over one command that is fine to run by hand;
# the point is not to hide docker compose, it is to stop retyping it.

@options timing

@define DEV_PORT "8000"
@define VITE_PORT "5173"
@define TS_HOST "bambuddy-dev"

@lib compose
  # Compose ships two ways — as a `docker compose` plugin and as a standalone
  # `docker-compose` binary — and a machine can have either. Pick what answers
  # instead of assuming.
  dc() {
    if docker compose version >/dev/null 2>&1; then
      docker compose "$@"
    else
      docker-compose "$@"
    fi
  }

# ---------------------------------------------------------------- preconditions

@goal default
@doc 'Bare `./makesure` lists what there is to run'
  ./makesure -l

@goal docker_up @private
@doc 'Fail early with a useful message when the Docker VM is not running'
  if ! docker info >/dev/null 2>&1; then
    echo "Docker is not reachable. Start the VM first:" >&2
    echo "  colima start --profile arm --arch aarch64 --cpu 4 --memory 6" >&2
    echo "  docker context use colima-arm" >&2
    exit 1
  fi

@goal tailnet_configured @private
@doc 'The tailnet profile needs an auth key and the full node name'
  if [[ -z "${TS_AUTHKEY:-}" ]] && ! grep -qs '^TS_AUTHKEY=' .env; then
    echo "TS_AUTHKEY is not set." >&2
    echo "Create a reusable auth key at https://login.tailscale.com/admin/settings/keys" >&2
    echo "and put it in .env as TS_AUTHKEY=tskey-auth-..." >&2
    exit 1
  fi

  # vite rejects a Host header it was not told about, so it needs the full
  # name. It stays in .env rather than here: the repo is public and the
  # tailnet name is not something to publish.
  if [[ -z "${TS_HOSTNAME:-}" ]] && ! grep -qs '^TS_HOSTNAME=' .env; then
    echo "TS_HOSTNAME is not set — vite would answer the tailnet request with" >&2
    echo "\"Blocked request. This host is not allowed\"." >&2
    echo "Add to .env:  TS_HOSTNAME=$TS_HOST.<your-tailnet>.ts.net" >&2
    exit 1
  fi

# ------------------------------------------------------------------------- dev

@goal up
@depends_on docker_up
@doc 'Start the dev stack (backend + frontend) on localhost'
@use_lib compose
  dc up -d
  echo
  echo "  UI       http://localhost:$VITE_PORT"
  echo "  API      http://localhost:$DEV_PORT"
  echo
  echo "The frontend installs node_modules on its first start, and again"
  echo "whenever package-lock.json changes:"
  echo "  ./makesure logs-frontend"

@goal ts
@depends_on docker_up
@depends_on tailnet_configured
@doc 'Start the dev stack and publish it on the tailnet as bambuddy-dev'
@use_lib compose
  dc --profile ts up -d

  # Goals do not inherit .env — that file is read by compose, not by the shell
  # makesure runs. Read the name here so the URL printed is the real one.
  ts_host=${TS_HOSTNAME:-$(sed -n 's/^TS_HOSTNAME=//p' .env 2>/dev/null | head -1)}

  echo
  echo "  UI       https://${ts_host:-$TS_HOST.<tailnet>.ts.net}"
  echo "  local    http://localhost:$VITE_PORT"
  echo
  echo "The certificate is issued on first use — give it a few seconds."
  echo "  ./makesure logs-ts"

@goal down
@depends_on docker_up
@doc 'Stop the dev stack, tailnet sidecar included'
@use_lib compose
  dc --profile ts down

@goal restart
@depends_on docker_up
@doc 'Restart the backend container (needed after a restore)'
@use_lib compose
  dc restart bambuddy

@goal logs
@depends_on docker_up
@doc 'Follow the backend log'
@use_lib compose
  dc logs -f bambuddy

@goal logs-frontend
@depends_on docker_up
@doc 'Follow the vite log'
@use_lib compose
  dc logs -f frontend

@goal logs-ts
@depends_on docker_up
@use_lib compose
@doc 'Follow the Tailscale sidecar log'
  dc logs -f tailscale

@goal shell
@depends_on docker_up
@use_lib compose
@doc 'Shell in a container: ./makesure shell (backend), SERVICE=frontend|ts ./makesure shell'
  # The compose service is called bambuddy, but "backend" is what it is next to
  # the frontend, so both names work.
  case "${SERVICE:-backend}" in
    backend|bambuddy) svc=bambuddy ;;
    front|frontend)   svc=frontend ;;
    ts|tailscale)     svc=tailscale ;;
    *)                svc=$SERVICE ;;
  esac

  # The backend image has bash; node:22-slim and the tailscale image only have sh.
  dc exec "$svc" sh -c 'command -v bash >/dev/null && exec bash || exec sh'

@goal ps
@depends_on docker_up
@doc 'What is running'
@use_lib compose
  dc --profile ts ps

# ------------------------------------------------------------------------ data

@goal deps
@depends_on docker_up
@doc 'Force a clean npm ci in the frontend container'
@use_lib compose
  dc exec frontend rm -f node_modules/.lock-hash
  dc restart frontend
  echo "Reinstalling — watch it with: ./makesure logs-frontend"

@goal restore
@depends_on docker_up
@doc 'Restore a backup into the local copy: newest ~/Downloads/bambuddy-backup*.zip, or ZIP=<path>'
  # API keys are denied settings:backup, so the ZIP is saved by hand from
  # Settings → Backup and lands in ~/Downloads. Take the newest one rather than
  # making the exact timestamped name something to retype.
  zip=${ZIP:-}
  if [ -z "$zip" ]; then
    zip=$HOME/Downloads/bambuddy-backup.zip
    if [ ! -f "$zip" ]; then
      zip=$(ls -t "$HOME"/Downloads/bambuddy-backup*.zip 2>/dev/null | head -1)
    fi
  fi

  if [ -n "$zip" ] && [ -f "$zip" ]; then
    echo "Using $zip"
    scripts/dev-restore.sh "$zip"
  else
    # Nothing local — fall back to the API download, which only works for a
    # principal allowed settings:backup.
    scripts/dev-restore.sh
  fi

@goal pull
@depends_on docker_up
@doc 'Pull a newer fork image and recreate the backend'
@use_lib compose
  dc pull bambuddy
  dc up -d bambuddy

# --------------------------------------------------------------------- quality

@goal lint
@doc 'Ruff, the same checks CI runs'
  ruff check backend/
  ruff format --check backend/

@goal test
@doc 'Backend tests'
  cd backend && python -m pytest tests/

@goal test-spoolbuddy
@doc 'SpoolBuddy driver tests'
  cd spoolbuddy && python -m pytest tests/

@goal check
@depends_on lint
@depends_on test
@doc 'Everything that must pass before a commit'
  echo "OK"

# -------------------------------------------------------------------- upstream

@goal sync
@doc 'Fast-forward the main/dev mirrors and mirror upstream tags'
  scripts/sync-upstream.sh

@goal sync-merge
@doc 'The same, then merge main into master'
  scripts/sync-upstream.sh --merge

# --------------------------------------------------------------------- release

@goal release
@doc 'Tag and push a release, building the image: VERSION=1.2.5.5-jbo.2 ./makesure release'
  if [[ -z "${VERSION:-}" ]]; then
    echo 'Set VERSION, e.g. VERSION=1.2.5.5-jbo.2 ./makesure release' >&2
    exit 1
  fi

  app_version=$(sed -n 's/^APP_VERSION = "\(.*\)"$/\1/p' backend/app/core/config.py)
  base=${VERSION%%-jbo.*}
  if [[ "$base" != "$app_version" ]]; then
    echo "VERSION base '$base' does not match APP_VERSION '$app_version' in backend/app/core/config.py." >&2
    echo "The build workflow rejects this, so fix one of them first." >&2
    exit 1
  fi

  if [[ -n "$(git status --porcelain)" ]]; then
    echo "Working tree is dirty — commit first." >&2
    exit 1
  fi

  git tag "v${VERSION}"
  git push origin master "v${VERSION}"
  echo
  echo "Watch the build:  gh run watch -R grengojbo/bambuddy \$(gh run list -R grengojbo/bambuddy --workflow=docker-ghcr.yml --limit 1 --json databaseId --jq '.[0].databaseId')"
